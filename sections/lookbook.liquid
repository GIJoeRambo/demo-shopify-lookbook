{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'section-lookbook.css' | asset_url | stylesheet_tag }}

{% liquid
  assign lookbook = section.settings.lookbook
  assign content_color = section.settings.content_color
  assign layout = section.settings.layout
%}

{% if lookbook != blank %}
  {% liquid
    assign lookbook_eyebrow = lookbook.eyebrow.value
    assign lookbook_title = lookbook.title.value
    assign lookbook_description = lookbook.description.value
    assign lookbook_image = lookbook.image.value
    assign lookbook_products = lookbook.products.value
    assign lookbook_target_collection = lookbook.target_collection.value
    assign lookbook_cta_label = lookbook.cta_button_text.value
  %}

  <section
    id="Lookbook-{{ section.id }}"
    class="lookbook lookbook--{{ layout }}"
    style="--content-color: {{ content_color }};"
  >
    <div class="lookbook__hero">
      {% if lookbook_image != blank %}
        <picture class="lookbook__hero-media">
          {{
            lookbook_image
            | image_url: width: 2200
            | image_tag:
              class: 'lookbook__hero-image',
              widths: '750, 1100, 1500, 1800, 2200',
              sizes: '(min-width: 1600px) 1080px, 72vw',
              loading: 'lazy',
              alt: lookbook_title
          }}
        </picture>

        <span
          class="lookbook__hero-overlay"
          aria-hidden="true"
        ></span>
      {% endif %}

      <div class="lookbook__content">
        {% if lookbook_eyebrow != blank %}
          <p class="lookbook__eyebrow">
            {{ lookbook_eyebrow | escape }}
          </p>
        {% endif %}

        {% if lookbook_title != blank %}
          <h2 class="lookbook__title">
            {{ lookbook_title | escape }}
          </h2>
        {% endif %}

        {% if lookbook_description != blank %}
          <div class="lookbook__description">
            {{ lookbook_description | escape }}
          </div>
        {% endif %}

        {% if lookbook_target_collection != blank and lookbook_cta_label != blank %}
          <a
            href="{{ lookbook_target_collection.url }}"
            class="lookbook__button"
          >
            {{ lookbook_cta_label | escape }}
          </a>
        {% endif %}
      </div>
    </div>

    {% if lookbook_products != blank %}
      <slider-component class="lookbook__products">
        <ul
          id="Slider-{{ section.id }}"
          class="lookbook__product-list slider"
          role="list"
        >
          {% for product in lookbook_products %}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="lookbook__product slider__slide"
            >
              <div class="lookbook__product-card">
                {% render 'card-product',
                  card_product: product,
                  show_secondary_image: true,
                  show_vendor: false,
                  show_rating: false,
                  show_quick_add: false,
                  section_id: section.id
                %}
              </div>
            </li>
          {% endfor %}
        </ul>

        {% if lookbook_products.size > 1 %}
          <div class="lookbook__slider-buttons">
            <button
              type="button"
              class="lookbook__slider-button lookbook__slider-button--prev slider-button slider-button--prev"
              name="previous"
              aria-controls="Slider-{{ section.id }}"
            >
              {% render 'icon-caret' %}
            </button>

            <div class="lookbook__product-counter slider-counter caption">
              <span class="slider-counter--current">1</span>
              <span aria-hidden="true"> / </span>
              <span class="visually-hidden">
                {{ 'general.slider.of' | t }}
              </span>
              <span class="slider-counter--total">
                {{ lookbook_products.size }}
              </span>
            </div>

            <button
              type="button"
              class="lookbook__slider-button lookbook__slider-button--next slider-button slider-button--next"
              name="next"
              aria-controls="Slider-{{ section.id }}"
            >
              {% render 'icon-caret' %}
            </button>
          </div>
        {% endif %}
      </slider-component>
    {% endif %}
  </section>
{% endif %}

{% schema %}
{
  "name": "Lookbook",
  "class": "section",
  "settings": [
    {
      "type": "metaobject",
      "id": "lookbook",
      "label": "Lookbook",
      "metaobject_type": "lookbook",
      "info": "Select the Lookbook content to display."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content color",
      "default": "#ffffff",
      "info": "Applies to the eyebrow, title and description."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "hero-left",
          "label": "Hero left"
        },
        {
          "value": "hero-right",
          "label": "Hero right"
        }
      ],
      "default": "hero-left",
      "info": "Choose which side the hero image appears on for larger screens."
    }
  ],
  "presets": [
    {
      "name": "Lookbook"
    }
  ]
}
{% endschema %}